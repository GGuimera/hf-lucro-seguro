# Modelo do arquivo .env (as chaves são OPCIONAIS).
# Para usar: copie este arquivo com o nome ".env" (na mesma pasta) e preencha só o que quiser usar.
# O .env nunca vai para o GitHub nem para o site.

# OpenAlex (artigos científicos) — chave GRÁTIS em https://openalex.org/settings/api
# Sem ela: ~100 buscas por dia (a carga completa leva uns dias). Com ela: tudo numa rodada só.
OPENALEX_API_KEY=

# Interpretação dos artigos com IA (Claude) — chave PAGA em https://console.anthropic.com
# Sem ela, a interpretação com IA fica desligada (custo zero).
ANTHROPIC_API_KEY=
# Modelo (padrão claude-opus-5-5; claude-haiku-5-5 sai bem mais barato) e quantos artigos por dia (padrão 100)
ARTIGOS_IA_MODELO=
ARTIGOS_IA_LIMITE=
